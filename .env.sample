# Example environment variables setup for AIDN Application

# Make a copy of this file and Rename it to .env then update it with your actual values

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Flask application settings
SECRET_KEY=your-super-secure-secret-key-minimum-32-characters-long
FLASK_ENV=development
DEBUG=True

# Security Settings
MAX_CONTENT_LENGTH=52428800

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=300

# Session Configuration
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_IP=10

# Production Security Settings (only used in production)
# Comma-separated IP ranges allowed to access admin endpoints
ALLOWED_IP_RANGES=

# Comma-separated ISO country codes to block
BLOCKED_COUNTRIES=

# CORS Configuration (production)
# Comma-separated allowed origins
ALLOWED_ORIGINS=

# File Upload Limits
MAX_FILE_SIZE_XLSX=52428800
MAX_FILE_SIZE_CSV=10485760
MAX_FILE_SIZE_TXT=1048576

# Logging Configuration
LOG_LEVEL=INFO
SECURITY_LOG_FILE=security.log
ACCESS_LOG_FILE=access.log

# LLM API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-name
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
